local function tweenToInteract(targetPart)
	local char = player.Character
	if not char then return false end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not humanoid then return false end

	local seat = humanoid.SeatPart
	local vehicleModel = getVehicleModel(seat)
	local groundTargetCFrame = targetPart.CFrame + Vector3.new(0, 3, 0)

	if seat and vehicleModel then
		local rootPart = vehicleModel.PrimaryPart or seat
		local distance = (rootPart.Position - targetPart.Position).Magnitude
		local duration = math.clamp(distance / 80, 0.15, 0.8)

		local cframeValue = Instance.new("CFrameValue")
		cframeValue.Value = vehicleModel:GetPivot()

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(cframeValue, tweenInfo, {Value = groundTargetCFrame})

		local connection = cframeValue.Changed:Connect(function(newCFrame)
			if vehicleModel and vehicleModel.Parent then
				vehicleModel:PivotTo(newCFrame)
			end
		end)

		tween:Play()
		
		local elapsed = 0
		while elapsed < duration and tween.PlaybackState == Enum.PlaybackState.Playing do
			elapsed = elapsed + RunService.Heartbeat:Wait()
		end
		
		connection:Disconnect()
		cframeValue:Destroy()

		if CONFIG.TweenDelay > 0 then
			task.wait(CONFIG.TweenDelay)
		end
		dismountVehicle()
		return true
	else
		local distance = (hrp.Position - targetPart.Position).Magnitude
		local duration = math.clamp(distance / 80, 0.15, 0.8)

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(hrp, tweenInfo, {CFrame = groundTargetCFrame})

		tween:Play()
		local elapsed = 0
		while elapsed < duration and tween.PlaybackState == Enum.PlaybackState.Playing do
			elapsed = elapsed + RunService.Heartbeat:Wait()
		end

		if CONFIG.TweenDelay > 0 then
			task.wait(CONFIG.TweenDelay)
		end
		return true
	end
end

local function goToTarget(targetPart)
	local reached = moveToTargetVelocity(targetPart)
	if not reached or not isRunning then return false end

	return tweenToInteract(targetPart)
end

local function processWaypoints(waypoints, labelPrefix)
	for i, pos in ipairs(waypoints) do
		if not isRunning then break end
		statusLabel.Text = string.format("Status: %s (%d/%d)...", labelPrefix, i, #waypoints)
		
		if i == 1 then
			getInVehicle()
		end
		
		moveToPositionVelocity(pos)
	end
end

local function interactWith(targetPart, prompt)
	local activePrompt = prompt or targetPart:FindFirstChildOfClass("ProximityPrompt") or targetPart.Parent:FindFirstChildOfClass("ProximityPrompt") or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
	
	if activePrompt then
		if fireproximityprompt then
			fireproximityprompt(activePrompt)
		else
			activePrompt:InputHoldBegin()
			task.wait(0.05)
			activePrompt:InputHoldEnd()
		end
		return
	end

	local clickDetector = targetPart:FindFirstChildOfClass("ClickDetector") or targetPart.Parent:FindFirstChildOfClass("ClickDetector") or targetPart:FindFirstChildWhichIsA("ClickDetector", true)
	if clickDetector and fireclickdetector then
		fireclickdetector(clickDetector)
	end
end

local function getProcessableItemCount()
	local count = 0

	if player:FindFirstChild("Backpack") then
		for _, item in ipairs(player.Backpack:GetChildren()) do
			if item:IsA("Tool") and not isProtectedItem(item.Name) then
				count = count + 1
			end
		end
	end
	
	local char = player.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") and not isProtectedItem(item.Name) then
				count = count + 1
			end
		end
	end

	return count
end

local function getItemCount(itemName)
	local count = 0
	local key = string.lower(itemName)

	if player:FindFirstChild("Backpack") then
		for _, item in ipairs(player.Backpack:GetChildren()) do
			if string.find(string.lower(item.Name), key) then count = count + 1 end
		end
	end
	
	local char = player.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), key) then count = count + 1 end
		end
	end

	return count
end

-- 3. Main Auto Farm Loop
local function mainLoop()
	local savedBuyPart, savedBuyPrompt = nil, nil

	while isRunning do
		if getItemCount(CONFIG.ItemName) < CONFIG.Amount then
			if not savedBuyPart then
				savedBuyPart, savedBuyPrompt = findTarget(CONFIG.ItemName)
			end

			if savedBuyPart then
				statusLabel.Text = "Status: Traveling to Shop..."
				getInVehicle()

				if goToTarget(savedBuyPart) then
					while isRunning and getItemCount(CONFIG.ItemName) < CONFIG.Amount do
						local currentCount = getItemCount(CONFIG.ItemName)
						statusLabel.Text = string.format("Status: Buying (%d/%d)", currentCount, CONFIG.Amount)
						interactWith(savedBuyPart, savedBuyPrompt)
						task.wait(0.2)
					end
					getInVehicle()
				end
			else
				statusLabel.Text = "Status: Searching Shop Target..."
				task.wait(1)
			end
		end

		if not isRunning then break end

		processWaypoints(postBuyWaypoints, "Post-Buy Route")

		if not isRunning then break end

		if autoSell and getItemCount(CONFIG.ItemName) > 0 then
			local lastBuyPos = postBuyWaypoints[#postBuyWaypoints]
			statusLabel.Text = "Status: Selling Goods..."
			
			local sellPart, sellPrompt = findNearestTargetToPos(CONFIG.SellName, lastBuyPos)
			if not sellPart then
				sellPart, sellPrompt = findNearestTargetToPos("Smuggle", lastBuyPos)
			end

			if sellPart then
				if goToTarget(sellPart) then
					local attempts = 0
					while isRunning and getItemCount(CONFIG.ItemName) > 0 and attempts < 25 do
						local currentCount = getItemCount(CONFIG.ItemName)
						statusLabel.Text = string.format("Status: Selling Items (%d Left)...", currentCount)
						interactWith(sellPart, sellPrompt)
						task.wait(0.2)
						attempts = attempts + 1
					end
					getInVehicle()
				end
			else
				statusLabel.Text = "Status: Searching Seller..."
				task.wait(1)
			end
		end

		if not isRunning then break end

		processWaypoints(postSellWaypoints, "Post-Sell Route")

		if not isRunning then break end

		if autoLaunder then
			statusLabel.Text = "Status: Traveling to Launder..."
			getInVehicle()

			local launderPart, launderPrompt = findTarget(CONFIG.LaunderName)
			if launderPart then
				if goToTarget(launderPart) then
					local launderAttempts = 0
					while isRunning and getProcessableItemCount() > 0 and launderAttempts < 40 do
						local leftCount = getProcessableItemCount()
						statusLabel.Text = string.format("Status: Laundering Cash (%d left)...", leftCount)
						interactWith(launderPart, launderPrompt)
						task.wait(0.3)
						launderAttempts = launderAttempts + 1
					end
					statusLabel.Text = "Status: Laundering Completed!"
					task.wait(0.2)
					getInVehicle()
				end
			else
				statusLabel.Text = "Status: Searching Launder Point..."
				task.wait(1)
			end
		end
		
		task.wait(0.1)
	end
	statusLabel.Text = "Status: Stopped"
end

-- Start/Stop Button Control Event with Color Animation
startBtn.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	if isRunning then
		startBtn.Text = "STOP FARMING"
		TweenService:Create(startBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(231, 76, 60)}):Play()
		TweenService:Create(startGlow, TweenInfo.new(0.2), {Color = Color3.fromRGB(231, 76, 60)}):Play()
		task.spawn(mainLoop)
	else
		startBtn.Text = "START FARMING"
		TweenService:Create(startBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(46, 204, 113)}):Play()
		TweenService:Create(startGlow, TweenInfo.new(0.2), {Color = Color3.fromRGB(46, 204, 113)}):Play()
	end
end)
