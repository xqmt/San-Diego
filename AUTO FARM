local activeObjs = {}
local activeBeams = {}
local pathConn = nil

local function clearPath()
	if pathConn then
		pathConn:Disconnect()
		pathConn = nil
	end
	for _, v in ipairs(activeObjs) do
		if v and v.Parent then v:Destroy() end
	end
	activeObjs = {}
	activeBeams = {}
	pathFolder:ClearAllChildren()
end

local function updateBeams()
	for _, item in ipairs(activeBeams) do
		if item.Beam and item.Beam.Parent then
			item.Beam.Width0 = pathGlow
			item.Beam.Width1 = pathGlow
			item.Beam.TextureLength = pathLen
			item.Beam.TextureSpeed = pathSpd
		end
	end
end

local function renderPath(wps, idx)
	clearPath()
	if not showPath or not wps or idx > #wps then return end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local pts = { hrp.Position }
	for i = idx, #wps do table.insert(pts, wps[i]) end

	activeBeams = {}
	for i = 1, #pts - 1 do
		local p1, p2 = pts[i], pts[i+1]
		local partA = Instance.new("Part")
		partA.Size = Vector3.new(0.1, 0.1, 0.1)
		partA.Position = p1
		partA.Anchored = true
		partA.CanCollide = false
		partA.Transparency = 1
		partA.Parent = pathFolder

		local partB = Instance.new("Part")
		partB.Size = Vector3.new(0.1, 0.1, 0.1)
		partB.Position = p2
		partB.Anchored = true
		partB.CanCollide = false
		partB.Transparency = 1
		partB.Parent = pathFolder

		local b = Instance.new("Beam")
		b.Attachment0 = Instance.new("Attachment", partA)
		b.Attachment1 = Instance.new("Attachment", partB)
		b.Texture = "rbxassetid://446111271"
		b.TextureMode = Enum.TextureMode.Wrap
		b.TextureLength = pathLen
		b.TextureSpeed = pathSpd
		b.Width0 = pathGlow
		b.Width1 = pathGlow
		b.Transparency = NumberSequence.new(0)
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Parent = pathFolder

		table.insert(activeObjs, partA)
		table.insert(activeObjs, partB)
		table.insert(activeBeams, {Beam = b, Index = i})
	end

	pathConn = runService.RenderStepped:Connect(function()
		local t = (tick() * 0.5) % 1
		for _, item in ipairs(activeBeams) do
			if item.Beam and item.Beam.Parent then
				local f1 = math.sin((t + (item.Index * 0.1)) * math.pi * 2) * 0.5 + 0.5
				local f2 = math.sin((t + ((item.Index + 1) * 0.1)) * math.pi * 2) * 0.5 + 0.5
				item.Beam.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, col1:Lerp(col2, f1)),
					ColorSequenceKeypoint.new(1, col1:Lerp(col2, f2))
				})
			end
		end
	end)
end

