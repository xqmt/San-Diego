		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			pcall(function() 
				hum.DisplayName = SPOOF_NAME 
			end)
		end

		for _, v in ipairs(char:GetDescendants()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				pcall(function()
					v.RichText = true
					if string.find(v.Text, origName) or string.find(v.Text, origDisplay) or string.find(v.Text, SPOOF_NAME) then
						v.Text = formattedName
					end
				end)
			end
		end
	end
end

