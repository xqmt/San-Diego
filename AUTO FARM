-- ESP Implementation Logic
local espObjects = {}

local function getTeamColor(player)
	if player.Team then
		return player.TeamColor.Color
	end
	return Color3.fromRGB(255, 255, 255)
end

local function createESP(player)
	if player == lp then return end
	
	local esp = {
		Highlight = nil,
		Bones = {}
	}
	
	local bonePairs = {
		{"Head", "UpperTorso"},
		{"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"},
		{"LeftUpperArm", "LeftLowerArm"},
		{"LeftLowerArm", "LeftHand"},
		{"UpperTorso", "RightUpperArm"},
		{"RightUpperArm", "RightLowerArm"},
		{"RightLowerArm", "RightHand"},
		{"LowerTorso", "LeftUpperLeg"},
		{"LeftUpperLeg", "LeftLowerLeg"},
		{"LeftLowerLeg", "LeftFoot"},
		{"LowerTorso", "RightUpperLeg"},
		{"RightUpperLeg", "RightLowerLeg"},
		{"RightLowerLeg", "RightFoot"}
	}
	
	for i = 1, #bonePairs do
		local line = Drawing.new("Line")
		line.Thickness = 1.5
		line.Visible = false
		table.insert(esp.Bones, {Line = line, Pair = bonePairs[i]})
	end
	
	espObjects[player] = esp
end

local function removeESP(player)
	local esp = espObjects[player]
	if esp then
		if esp.Highlight then esp.Highlight:Destroy() end
		if esp.Bones then
			for _, b in ipairs(esp.Bones) do
				if b.Line then b.Line:Remove() end
			end
		end
		espObjects[player] = nil
	end
end

for _, p in ipairs(players:GetPlayers()) do createESP(p) end
players.PlayerAdded:Connect(createESP)
players.PlayerRemoving:Connect(removeESP)

-- ESP Updater Render Loop
runService.RenderStepped:Connect(function()
	for player, esp in pairs(espObjects) do
		local char = player.Character
		local teamColor = getTeamColor(player)
		local isTeammate = (espSettings.TeamCheck and player.Team == lp.Team)
		
		if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 and not isTeammate then
			local teamCol = getTeamColor(player)
			
			-- 1. Chams (No Outline)
			if espSettings.Chams then
				if not esp.Highlight or esp.Highlight.Parent ~= char then
					if esp.Highlight then esp.Highlight:Destroy() end
					local hl = Instance.new("Highlight")
					hl.Adornee = char
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 1 -- No Outline
					hl.Parent = char
					esp.Highlight = hl
				end
				esp.Highlight.FillColor = teamCol
				esp.Highlight.Enabled = true
			else
				if esp.Highlight then
					esp.Highlight.Enabled = false
				end
			end
			
			-- 2. Skeleton ESP
			if espSettings.Skeleton then
				for _, bData in ipairs(esp.Bones) do
					local p1 = char:FindFirstChild(bData.Pair[1])
					local p2 = char:FindFirstChild(bData.Pair[2])
					
					if p1 and p2 then
						local pos1, vis1 = camera:WorldToViewportPoint(p1.Position)
						local pos2, vis2 = camera:WorldToViewportPoint(p2.Position)
						
						if vis1 and vis2 then
							bData.Line.From = Vector2.new(pos1.X, pos1.Y)
							bData.Line.To = Vector2.new(pos2.X, pos2.Y)
							bData.Line.Color = teamCol
							bData.Line.Visible = true
						else
							bData.Line.Visible = false
						end
					else
						bData.Line.Visible = false
					end
				end
			else
				for _, bData in ipairs(esp.Bones) do
					bData.Line.Visible = false
				end
			end
		else
			if esp.Highlight then esp.Highlight.Enabled = false end
			for _, bData in ipairs(esp.Bones) do bData.Line.Visible = false end
		end
	end
end)

-- Get Closest Player (Without Wall Check)
local function getClosestPlayer()
	local closestPlayer = nil
	local shortestDistance = silentAimSettings.FOV
	local mousePos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, player in ipairs(players:GetPlayers()) do
		if player ~= lp then
			if silentAimSettings.TeamCheck and player.Team == lp.Team then continue end

			local char = player.Character
			if char and char:FindFirstChild(silentAimSettings.TargetPart) then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if silentAimSettings.KillCheck and (not hum or hum.Health <= 0) then continue end

				local targetPart = char[silentAimSettings.TargetPart]
				local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)

				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist < shortestDistance then
						shortestDistance = dist
						closestPlayer = targetPart
					end
				end
			end
		end
	end
	return closestPlayer
end

