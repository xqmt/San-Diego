		origLight.Ambient = lighting.Ambient
		origLight.FogEnd = lighting.FogEnd
		origLight.Technology = lighting.Technology

		lighting.GlobalShadows = false
		lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
		lighting.Ambient = Color3.fromRGB(0, 0, 0)
		lighting.FogEnd = 9e9
		pcall(function() lighting.Technology = Enum.Technology.Compatibility end)

		for _, v in ipairs(lighting:GetChildren()) do
			if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
				pcall(function() v:Destroy() end)
			end
		end

		if workspace.Terrain then
			pcall(function()
				workspace.Terrain.WaterWaveSize = 0
				workspace.Terrain.WaterWaveSpeed = 0
				workspace.Terrain.WaterReflectance = 0
				workspace.Terrain.WaterTransparency = 0
				workspace.Terrain.Decoration = false
			end)
		end

		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
		end)

		local descs = workspace:GetDescendants()
		task.spawn(function()
			for i = 1, #descs do
				cleanInst(descs[i])
				if i % 300 == 0 then task.wait() end
			end
		end)

		table.insert(fpsConns, workspace.DescendantAdded:Connect(function(v)
			if fpsBoost then cleanInst(v) end
		end))

		for _, p in ipairs(players:GetPlayers()) do
			if p.Character then stripChar(p.Character) end
			table.insert(fpsConns, p.CharacterAdded:Connect(function(c)
				if fpsBoost then
					c:WaitForChild("Humanoid", 5)
					task.wait(0.1)
					stripChar(c)
				end
			end))
		end

		task.spawn(function()
			while fpsBoost do
				task.wait(30)
				pcall(function() gcinfo() end)
			end
		end)
	else
		for _, c in ipairs(fpsConns) do if c then c:Disconnect() end end
		fpsConns = {}
		lighting.GlobalShadows = origLight.GlobalShadows or true
		lighting.OutdoorAmbient = origLight.OutdoorAmbient or Color3.fromRGB(128, 128, 128)
		lighting.Ambient = origLight.Ambient or Color3.fromRGB(128, 128, 128)
	end
end

local function getTarget(key)
	key = string.lower(key)
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("ProximityPrompt") then
			local oText = string.lower(p.ObjectText or "")
			local aText = string.lower(p.ActionText or "")
			local pName = string.lower(p.Parent and p.Parent.Name or "")
			if string.find(oText, key) or string.find(aText, key) or string.find(pName, key) then
				local part = p:FindFirstAncestorWhichIsA("BasePart") or p.Parent
				if part:IsA("BasePart") then return part, p
				elseif part:IsA("Model") then
					local main = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
					if main then return main, p end
				end
			end
		end
	end
	return nil, nil
end

local function getNearestTarget(key, pos)
	key = string.lower(key)
	local bestPart, bestPrompt = nil, nil
	local minDist = math.huge
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("ProximityPrompt") then
			local oText = string.lower(p.ObjectText or "")
			local aText = string.lower(p.ActionText or "")
			local pName = string.lower(p.Parent and p.Parent.Name or "")
			if string.find(oText, key) or string.find(aText, key) or string.find(pName, key) then
				local part = p:FindFirstAncestorWhichIsA("BasePart") or p.Parent
				if part then
					local main = part:IsA("BasePart") and part or part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
					if main then
						local dist = (pos - main.Position).Magnitude
						if dist < minDist then
							minDist = dist
							bestPart = main
							bestPrompt = p
						end
					end
				end
			end
		end
	end
	return bestPart, bestPrompt
end

local function getVehicle(seat)
	if not seat then return nil end
	local cur = seat
	local model = nil
	while cur and cur ~= workspace do
		if cur:IsA("Model") then model = cur end
		cur = cur.Parent
	end
	return model
end

local function exitVehicle()
	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	
	if hum and hum.SeatPart then
		lastVeh = getVehicle(hum.SeatPart)
		if lastVeh then
			for _, v in ipairs(lastVeh:GetDescendants()) do
				if v:IsA("BasePart") then
					v.AssemblyLinearVelocity = Vector3.zero
					v.AssemblyAngularVelocity = Vector3.zero
				end
			end
			local main = lastVeh.PrimaryPart or lastVeh:FindFirstChildWhichIsA("BasePart", true)
			if main then main.Anchored = true end
		end
		
		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		hum.Sit = false
		
		if hrp and lastVeh then
			local main = lastVeh.PrimaryPart or lastVeh:FindFirstChildWhichIsA("BasePart", true)
			if main then hrp.CFrame = main.CFrame * CFrame.new(0, 3, 0) end
		end
	end
end

local function enterVehicle()
	if not lastVeh or not lastVeh.Parent then return end
	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hum then return end
	
	local main = lastVeh.PrimaryPart or lastVeh:FindFirstChildWhichIsA("BasePart", true)
	if main then main.Anchored = false end
	if hum.SeatPart then return end
	
	local seat = lastVeh:FindFirstChildWhichIsA("VehicleSeat", true) or lastVeh:FindFirstChildWhichIsA("Seat", true)
	if seat then
		hrp.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
		seat:Sit(hum)
	end
end

local function getClosestWpIndex(wps, pos)
	local idx, minDist = 1, math.huge
	for i, wp in ipairs(wps) do
		local dist = (Vector3.new(pos.X, wp.Y, pos.Z) - wp).Magnitude
		if dist < minDist then
			minDist = dist
			idx = i
		end
	end
	return idx
end

local function moveVel(targetPos)
	local char = lp.Character
	if not char then return false, false end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hum then return false, false end
	
	local seat = hum.SeatPart
	local vModel = getVehicle(seat)
	local movePart = (seat and vModel) and (vModel.PrimaryPart or seat) or hrp
	if not movePart then return false, false end

	local float = Instance.new("Part")
	float.Name = "AntiFall_FloatPlatform"
	float.Size = Vector3.new(30, 1, 30)
	float.Anchored = true
	float.CanCollide = true
	float.Transparency = 1
	float.Parent = workspace

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
	bv.Velocity = Vector3.zero
	bv.Parent = movePart

	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
	bg.P = 10000
	bg.CFrame = movePart.CFrame
	bg.Parent = movePart

	local noclip = runService.Stepped:Connect(function()
		if not running then return end
		if movePart and movePart.Parent then float.CFrame = movePart.CFrame * CFrame.new(0, -3.5, 0) end
		if lp.Character then
			for _, v in ipairs(lp.Character:GetDescendants()) do
				if v:IsA("BasePart") and v ~= float then v.CanCollide = false end
			end
		end
		if vModel then
			for _, v in ipairs(vModel:GetDescendants()) do
				if v:IsA("BasePart") and v ~= float then v.CanCollide = false end
			end
		end
	end)

	local target = Vector3.new(targetPos.X, targetPos.Y + cfg.Height, targetPos.Z)
	local arrived, rbDetected = false, false
	local prevPos = movePart.Position
	local stopDist = math.clamp(cfg.Speed * 0.08, 12, 25)

	local render = runService.Heartbeat:Connect(function()
		if not running or not movePart or not movePart.Parent then arrived = false return end
		local curPos = movePart.Position
		local delta = (curPos - prevPos).Magnitude
		local dist = (target - curPos).Magnitude

		if delta > 45 and dist > 20 then
			rbDetected = true
			bv.Velocity = Vector3.zero
			return
		end
		
		prevPos = curPos
		if dist <= stopDist then
			arrived = true
			return
		end

		local spdFactor = math.clamp(dist / 40, 0.25, 1)
		local dir = (target - curPos)
		bv.Velocity = dir.Unit * (cfg.Speed * spdFactor)
		bg.CFrame = CFrame.lookAt(curPos, Vector3.new(target.X, curPos.Y, target.Z))
	end)

	while running and not arrived and not rbDetected do task.wait() end

	if noclip then noclip:Disconnect() end
	if render then render:Disconnect() end

	bv:Destroy()
	bg:Destroy()
	float:Destroy()

	if movePart and movePart.Parent then
		movePart.AssemblyLinearVelocity = Vector3.zero
		movePart.AssemblyAngularVelocity = Vector3.zero
	end

	if lp.Character then
		for _, v in ipairs(lp.Character:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide = true end
		end
	end

	return arrived, rbDetected
end

local function tweenInteract(targetPart)
	local char = lp.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hum then return false end

	local seat = hum.SeatPart
	local vModel = getVehicle(seat)
	local targetCF = targetPart.CFrame + Vector3.new(0, 1.2, 0)

	if seat and vModel then
		local dur = math.clamp((vModel.PrimaryPart.Position - targetPart.Position).Magnitude / 120, 0.05, 0.4)
		local cfVal = Instance.new("CFrameValue")
		cfVal.Value = vModel:GetPivot()

		local tw = tweenService:Create(cfVal, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Value = targetCF})
		local c = cfVal.Changed:Connect(function(newCF)
			if vModel and vModel.Parent then vModel:PivotTo(newCF) end
		end)

		tw:Play()
		tw.Completed:Wait()
		c:Disconnect()
		cfVal:Destroy()

		if cfg.TweenDelay > 0 then task.wait(cfg.TweenDelay) end
		exitVehicle()
		return true
	else
		local dur = math.clamp((hrp.Position - targetPart.Position).Magnitude / 120, 0.05, 0.4)
		local tw = tweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCF})
		tw:Play()
		tw.Completed:Wait()

		if cfg.TweenDelay > 0 then task.wait(cfg.TweenDelay) end
		exitVehicle()
		return true
	end
end

local function goToTarget(part)
	local reached = moveVel(part.Position)
	if not reached or not running then return false end
	return tweenInteract(part)
end

local function runWaypoints(wps, tag)
	local idx = 1
	while running and idx <= #wps do
		if idx == 1 then enterVehicle() end
		
		renderPath(wps, idx)
		notify(tag or "Moving", string.format("Waypoint %d/%d", idx, #wps), 1.2)
		
		local arrived, rb = moveVel(wps[idx])

		if rb then
			task.wait(0.1)
			local char = lp.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			
			if hrp then
				local nearIdx = getClosestWpIndex(wps, hrp.Position)
				idx = nearIdx
				
				local safePos = wps[nearIdx] + Vector3.new(0, cfg.Height, 0)
				local movePart = hrp
				
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum and hum.SeatPart then
					local vM = getVehicle(hum.SeatPart)
					if vM then movePart = vM.PrimaryPart or hum.SeatPart end
				end

				local tw = tweenService:Create(movePart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = CFrame.new(safePos)})
				tw:Play()
				tw.Completed:Wait()
			end
		elseif arrived then
			if sellCD and wps == buyWps and idx == 16 then
				local oldSpd = cfg.Speed
				cfg.Speed = 25
				local cd = math.random(50, 60) / 10
				notify("Sell Delay", string.format("Waiting sell cooldown... (%.1fs)", cd), cd)
				task.wait(cd)
				cfg.Speed = oldSpd
			end
			idx = idx + 1
		end
	end
	clearPath()
end

local function interact(part, prompt)
	local p = prompt or (part and part:FindFirstChildOfClass("ProximityPrompt"))
		or (part and part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
		or (part and part:FindFirstChildWhichIsA("ProximityPrompt", true))

	if p then
		if p.HoldDuration ~= 0 then p.HoldDuration = 0 end
		if fireproximityprompt then
			fireproximityprompt(p)
			return true
		else
			pcall(function()
				if p.InputHoldBegin then
					p:InputHoldBegin()
					p:InputHoldEnd()
				elseif p.PromptButtonHoldBegan then
					p:PromptButtonHoldBegan()
					p:PromptButtonHoldEnded()
				end
			end)
			return true
		end
	end

	local cd = (part and part:FindFirstChildOfClass("ClickDetector"))
		or (part and part.Parent and part.Parent:FindFirstChildOfClass("ClickDetector"))
		or (part and part:FindFirstChildWhichIsA("ClickDetector", true))

	if cd and fireclickdetector then
		fireclickdetector(cd)
		return true
	end

	return false
end

local function getProcessableCount()
	local count = 0
	local bp = lp:FindFirstChild("Backpack")
	if bp then
		for _, v in ipairs(bp:GetChildren()) do
			if v:IsA("Tool") and not isProtected(v.Name) then count = count + 1 end
		end
	end
	if lp.Character then
		for _, v in ipairs(lp.Character:GetChildren()) do
			if v:IsA("Tool") and not isProtected(v.Name) then count = count + 1 end
		end
	end
	return count
end

local function getItemCount(name)
	local count = 0
	local key = string.lower(name)
	local bp = lp:FindFirstChild("Backpack")
	if bp then
		for _, v in ipairs(bp:GetChildren()) do
			if string.find(string.lower(v.Name), key) then count = count + 1 end
		end
	end
	if lp.Character then
		for _, v in ipairs(lp.Character:GetChildren()) do
			if string.find(string.lower(v.Name), key) then count = count + 1 end
		end
	end
	return count
end

local function farmLoop()
	local buyPart, buyPrompt = nil, nil
	while running do
		if getItemCount(cfg.ItemName) < cfg.Amount then
			if not buyPart or not buyPart.Parent then
				buyPart, buyPrompt = getTarget(cfg.ItemName)
			end
			if buyPart then
				enterVehicle()
				if goToTarget(buyPart) then
					exitVehicle()
					local t = 0
					while running and getItemCount(cfg.ItemName) < cfg.Amount and t < 200 do
						interact(buyPart, buyPrompt)
						task.wait()
						t = t + 1
					end
					enterVehicle()
				end
			else
				task.wait(0.2)
			end
		end

		if not running then break end
		runWaypoints(buyWps, "Post-Buy Route")
		if not running then break end

		if autoSell then
			local lastPos = buyWps[#buyWps]
			local sellPart, sellPrompt = getNearestTarget(cfg.SellName, lastPos)
			if not sellPart then sellPart, sellPrompt = getNearestTarget("Smuggle", lastPos) end
			
			if sellPart then
				enterVehicle()
				if goToTarget(sellPart) then
					exitVehicle()
					local t = 0
					while running and getItemCount(cfg.ItemName) > 0 and t < 200 do
						interact(sellPart, sellPrompt)
						task.wait()
						t = t + 1
					end
					enterVehicle()
				end
			else
				task.wait(0.2)
			end
		end

		if not running then break end
		runWaypoints(sellWps, "Post-Sell Route")
		if not running then break end

		if autoLaunder then
			local ldrPart, ldrPrompt = getTarget(cfg.LaunderName)
			if ldrPart then
				enterVehicle()
				if goToTarget(ldrPart) then
					exitVehicle()
					local t = 0
					while running and getProcessableCount() > 0 and t < 200 do
						interact(ldrPart, ldrPrompt)
						task.wait()
						t = t + 1
					end
					enterVehicle()
				end
			else
				task.wait(0.2)
			end
		end
		
		task.wait()
	end
	clearPath()
end

