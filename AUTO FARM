-- --- ANIMATED PURPLE-BLACK GRADIENT SPOOF ---
local function getAnimatedGradientText(text)
	local result = ""
	local len = #text
	local t = tick() * 3 -- Speed of animation
	local c1 = Color3.fromRGB(150, 0, 255) -- Deep Neon Purple
	local c2 = Color3.fromRGB(15, 15, 15)   -- Soft Black
	
	for i = 1, len do
		local char = text:sub(i, i)
		local factor = (math.sin(t + (i * 0.4)) + 1) / 2
		local col = c1:Lerp(c2, factor)
		local hex = string.format("#%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255))
		result = result .. string.format('<font color="%s">%s</font>', hex, char)
	end
	return result
end

local function applySpoof()
	if not spoofActive then return end
