-- Hooking __namecall for Silent Aim
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local args = {...}
	local method = getnamecallmethod()

	if silentAimSettings.Enabled and currentTarget and math.random(1, 100) <= silentAimSettings.HitChance then
		if method == "Raycast" and self == workspace then
			args[2] = (currentTarget.Position - args[1]).Unit * args[2].Magnitude
			return oldNamecall(self, table.unpack(args))
		elseif method == "FindPartOnWithIgnoreList" or method == "FindPartOn" then
			if args[1] then
				local origin = args[1].Origin
				local dir = (currentTarget.Position - origin).Unit * 1000
				args[1] = Ray.new(origin, dir)
			end
			return oldNamecall(self, table.unpack(args))
		end
	end

	return oldNamecall(self, ...)
end)

local function playFlyEmote()
	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if flyTrack then
		flyTrack:Stop(0.1)
		flyTrack = nil
	end

	local animId = "rbxassetid://" .. tostring(FLY_ID)
	local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(FLY_ID)) end)
	if ok and res and #res > 0 and res[1]:IsA("Animation") then
		animId = res[1].AnimationId
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	
	local okPlay, track = pcall(function() return hum:LoadAnimation(anim) end)
	if okPlay and track then
		track.Priority = Enum.AnimationPriority.Action4
		track:Play(0.1, 1, 0.5)
		flyTrack = track
	end
end

local function stopFlyEmote()
	if flyTrack then
		flyTrack:Stop(0.1)
		flyTrack = nil
	end
end

local function toggleFly(state)
	flyActive = state
	if flyActive then playFlyEmote() else stopFlyEmote() end
end

